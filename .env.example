# QA-Platform/CMS - Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# DO NOT commit real secrets or credentials to source control.

# Database: PostgreSQL connection string (configured in Phase 1 via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qa_platform?schema=public"

# Ingestion API Key: Secret key used by Playwright reporter to submit test runs
# Sent via 'X-API-Key' header on POST /api/v1/test-runs
CMS_API_KEY="your-cms-api-key-here"

# GitHub Integration: Server-side token for creating/updating GitHub Issues
# Use a fine-grained Personal Access Token (PAT) with 'issues:write' permission
GITHUB_TOKEN="ghp_yourGitHubPersonalAccessTokenHere"

# Target GitHub Repository configuration
GITHUB_OWNER="your-github-organization-or-username"
GITHUB_REPO="your-target-repo-name"
